package-as: Encore

enable-nolib-creation: no

# Encore ships four addons (core, Shared, Paladin, Warrior); src/ also holds Hekili Forever's other class packs, kept
# only as test material and never shipped (ignored below). Move the four to the zip root (src/Encore replaces the package folder itself, so
# root files such as the licence do not survive: the copy in src/Encore/ is the shipped one, beside the wowsims/forever
# MIT notice that covers the class packs' translated (wowsims.com) priorities).
move-folders:
    Encore/src/Encore: Encore
    Encore/src/Encore_Shared: Encore_Shared
    Encore/src/Encore_Warrior: Encore_Warrior
    Encore/src/Encore_Paladin: Encore_Paladin

# The packager uploads nothing (release.yml passes -d; publish.yml uploads with the release body as the changelog).
# manual-changelog stays so the packager does not generate a CHANGELOG.md into the shipped Encore/ folder.
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

ignore:
    - README.md
    - DEVELOPMENT.md
    - CHANGELOG.md
    - src/Encore_Shared/README.md
    - tests
    - tools
    - docs
    - scripts
    - .superpowers
    - .github
    - .busted
    - .luacheckrc
    - .luarc.json
    - .stylua.toml
    - .styluaignore
    - Makefile
    - mise.toml
    - src/Encore_Warrior/APLs
    - src/Encore_Druid
    - src/Encore_Rogue
    - src/Encore_Shaman
    - src/Encore_Hunter
    - src/Encore_Mage
    - src/Encore_Priest
    - src/Encore_Warlock
    - src/Encore_Paladin/APLs
