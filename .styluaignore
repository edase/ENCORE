src/Encore/Engine/Schema/Spec/
src/Encore/Engine/Snapshot.lua
.claude/
.lua/
# The language files are written by tools/locales.py (one L[...] line per key, however long); Locales.lua is ours.
src/Encore/Locales/[a-z][a-z][A-Z][A-Z].lua
src/Encore_*/Locales/[a-z][a-z][A-Z][A-Z].lua
